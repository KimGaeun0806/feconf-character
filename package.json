{
  "name": "feconf-26-mascot",
  "version": "0.1.4",
  "description": "Desktop pixel-art snail mascot for FE builds, tests, and Web Vitals — plus FECONF conference cues (Electron)",
  "main": "main.js",
  "bin": {
    "feconf-26-mascot": "scripts/start-branded-dev.js",
    "feconf-mascot": "scripts/start-branded-dev.js",
    "feconf-2026-mascot": "scripts/start-branded-dev.js",
    "feconf-2026": "integrations/feconf.js",
    "feconf": "integrations/feconf.js",
    "mascot-watch": "integrations/mascot-watch.js",
    "mascot-dev": "integrations/mascot-dev.js"
  },
  "files": [
    "main.js",
    "preload.js",
    "lib/",
    "renderer/",
    "shared/",
    "character/*-long.json",
    "character/bubble-*.json",
    "assets/",
    "integrations/",
    "scripts/",
    "CUSTOMIZING.md",
    "OVERVIEW.md",
    "README.md"
  ],
  "scripts": {
    "start": "node scripts/start-branded-dev.js",
    "start:raw": "electron .",
    "notify": "node scripts/send.js",
    "watch": "node integrations/mascot-watch.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimGaeun0806/feconf-character.git"
  },
  "bugs": {
    "url": "https://github.com/KimGaeun0806/feconf-character/issues"
  },
  "homepage": "https://github.com/KimGaeun0806/feconf-character#readme",
  "keywords": [
    "feconf",
    "electron",
    "mascot",
    "desktop-pet",
    "pixel-art",
    "web-vitals",
    "build-tools",
    "developer-tools",
    "vite"
  ],
  "author": "FECONF",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron": "^33.2.0"
  }
}
